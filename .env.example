# Copy this file to .env and fill in real values.
# NEVER commit the real .env - it is git-ignored.

# OpenRouter API key used by server.js to generate learning cards.
# If this is not set, server.js falls back to its built-in mock generator.
OPENROUTER_API_KEY=

# OpenRouter model id. server.js defaults to 'openrouter/free' when unset.
OPENROUTER_MODEL=

# Port for the local Express server. Defaults to 3000.
PORT=
